<script>
function updateFirstCarouselImage() {
  // Check if product-detail product-wrapper exists
  if (!document.querySelector('.product-detail')) return;

  const activeCarousel = document.querySelector('.carousel-item.active');
  if (!activeCarousel) return;

  const firstImage = activeCarousel.querySelector('img[src*="size=800,800"]');
  if (firstImage) {
    firstImage.src = firstImage.src.replace('size=800,800', 'size=1200,1200');
  }
}

// Run function
updateFirstCarouselImage();

// Run again after every AJAX success
$(document).ajaxSuccess(function () {
  updateFirstCarouselImage();
});
</script>
