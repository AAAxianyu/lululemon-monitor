<script>
  Array.prototype.uniquePush = function (productToPush) {
      var list = this;
      var duplicateFound = false;

      for (var index = 0; index < list.length; index++) {
          var currentProduct = list[index];
          var currentProductSku = currentProduct.productInfo.sku;
          var productToPushSku = productToPush.productInfo.sku;

          if (currentProductSku === productToPushSku) {
              duplicateFound = true;
              break;
          }
      }

      if (duplicateFound === false) {
          list.push(productToPush);
      }

      return list.length;
  };
  var digitalData = {page: {error: {}, pageInfo: {pageName: "Sites-UK-Site", country: "GB", currency: "GBP", geoRegion: "gb", language: "en-GB", version: "default", pageID: "null"}, category: {primaryCategory: '', subCategory1: '', subCategory2: '', gender: 'all'}, attributes: {}}, product: [], user: [], version: 1, luluVersion: 2};
  if(true)
  {
	  digitalData.page.error = {"type":"410","message":"We can't seem to find the page you are looking for."};
  }
  
  

</script>

















