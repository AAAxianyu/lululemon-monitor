<script>
function getCookie(name) {
var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
return match ? decodeURIComponent(match[1]) : null;
}
var optanonConsent = getCookie('OptanonConsent');
if (optanonConsent) {
var optanonConsentTrackingRegex = /groups=[^&]*(?:C0003|3):(\d)/;
var functionalValue = optanonConsent.match(optanonConsentTrackingRegex);
if (window && functionalValue) {
functionalValue = parseInt(functionalValue[1], 10)
window.tfcConsent = functionalValue;
}
}
</script>














